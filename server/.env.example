# Copy to server/.env and fill in. Never commit the real .env.

# Visual Crossing Timeline API key (https://www.visualcrossing.com/)
WEATHER_API_KEY=your-visual-crossing-key

PORT=3001

# SQLite file (created automatically)
DB_PATH=./data/weather.db

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
